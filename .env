# n8n Docker Compose Environment Configuration
# Copy from .env.example and customize these values

# Domain Configuration
DOMAIN_NAME=taurak.co.uk
SUBDOMAIN=n8n
N8N_HOST=n8n.taurak.co.uk
SSL_EMAIL=admin@taurak.co.uk   

# Database Configuration
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SecurePostgresPass123!
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=SecureN8nPass123!

# n8n Authentication
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=SecureN8nAdminPass123!

# System Configuration
GENERIC_TIMEZONE=Europe/London
N8N_RUNNERS_ENABLED=true
