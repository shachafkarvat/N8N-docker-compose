  #     - DB_POSTGRESDB_USER=${POSTGRES_USER}
  #     - DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}
      
  #     # n8n Configuration
  #     - N8N_HOST=${N8N_HOST}
  #     - N8N_PORT=5678
  #     - N8N_PROTOCOL=https
  #     - WEBHOOK_URL=https://${N8N_HOST}
  #     - VUE_APP_URL_BASE_API=https://${N8N_HOST}
